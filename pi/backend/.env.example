# SOTA CW HL2 Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# HL2 Network Configuration
SOTA_CW_HL2_IP=192.168.1.50
SOTA_CW_HL2_PORT=1024
SOTA_CW_HL2_LOCAL_PORT=1025

# IO Board Configuration
SOTA_CW_IO_REG_BASE=200

# CW TX Envelope Shaping (HL2-side amplitude control)
# Defaults enable click-reduction out of the box
SOTA_CW_CW_ENV_RISE_US=3000
SOTA_CW_CW_ENV_FALL_US=3000
SOTA_CW_CW_ENV_SHAPE=0
SOTA_CW_CW_ENV_MAX_AMP_Q15=32767

# CW Decoder Configuration
SOTA_CW_USE_INTERNAL_STREAMER=true

# Logging
SOTA_CW_LOG_LEVEL=INFO

# API Configuration
SOTA_CW_API_HOST=0.0.0.0
SOTA_CW_API_PORT=8000
SOTA_CW_API_RELOAD=false
