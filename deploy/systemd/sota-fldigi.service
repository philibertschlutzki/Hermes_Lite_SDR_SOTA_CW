[Unit]
Description=fldigi Headless Daemon (PSK31/RTTY/CW Engine)
After=network.target sota-sdr-backend.service
Wants=sota-sdr-backend.service

[Service]
Type=simple
User=pi
Environment="DISPLAY=:99"
ExecStart=/usr/bin/xvfb-run -a -n 99 /usr/bin/fldigi --daemon --xmlrpc-server --xmlrpc-port 7362
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
