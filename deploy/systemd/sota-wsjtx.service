[Unit]
Description=WSJT-X Headless Daemon (FT8/FT4/WSPR/FST4 Engine)
After=network.target sota-sdr-backend.service
Wants=sota-sdr-backend.service

[Service]
Type=simple
User=pi
Environment="DISPLAY=:99"
ExecStartPre=/usr/bin/mkdir -p /home/pi/.local/share/WSJT-X
ExecStart=/usr/bin/xvfb-run -a -n 99 /usr/bin/wsjtx
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
